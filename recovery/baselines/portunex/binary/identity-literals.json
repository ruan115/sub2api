        {
          "start": 507602,
          "end": 509583,
          "sha256": "94fd60203a6afcdbe9735a8868538f1ff154603d29545c4778691d368be10726",
          "text": "            SELECT id, user_id, token, expires_at, ip_address, user_agent, created_at, last_used_at, deleted_at\n            FROM auth_sessions\n            WHERE user_id = $1 AND expires_at > NOW() AND deleted_at IS NULL\n            ORDER BY created_at DESC\n            \n            UPDATE auth_sessions\n            SET expires_at = $1, last_used_at = $2\n            WHERE id = $3 AND deleted_at IS NULL\n            \n            SELECT id, user_id, token, expires_at, ip_address, user_agent, created_at, last_used_at, deleted_at\n            FROM auth_sessions\n            WHERE token = $1 AND expires_at > NOW() AND deleted_at IS NULL\n            \n            SELECT id, user_id, token, expires_at, ip_address, user_agent, created_at, last_used_at, deleted_at\n            FROM auth_sessions\n            WHERE expires_at > NOW() AND deleted_at IS NULL\n            ORDER BY created_at DESC\n            \n            UPDATE auth_sessions\n            SET last_used_at = $1\n            WHERE id = $2 AND deleted_at IS NULL\n            \n            UPDATE auth_sessions\n            SET deleted_at = $2\n            WHERE user_id = $1 AND expires_at < $3 AND deleted_at IS NULL\n            RETURNING token\n            \n            UPDATE auth_sessions\n            SET deleted_at = $2\n            WHERE user_id = $1 AND deleted_at IS NULL AND id NOT IN (\n                SELECT id FROM auth_sessions\n                WHERE user_id = $1 AND deleted_at IS NULL\n                ORDER BY created_at DESC\n                LIMIT 10\n            )\n            RETURNING token\n            \n            SELECT id, user_id, token, expires_at, ip_address, user_agent, created_at, last_used_at, deleted_at\n            FROM auth_sessions\n            WHERE id = $1\n              AND ($2 OR deleted_at IS NULL)\n            \n            INSERT INTO auth_sessions (id, user_id, token, expires_at, ip_address, user_agent, created_at, last_used_at)\n            VALUES ($1, $2, $3, $4, $5, $6, $7, $7)\n            \n"
